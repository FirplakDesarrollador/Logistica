# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# Proyecto Supabase: Firplak SA › Manufactura · schema: logistica

# MCP de Supabase (scripts/mcp-supabase.mjs). Solo desarrollo.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# App
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Script de carga del histórico (solo servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Descarga de Excel desde SharePoint (scripts/descargar-sharepoint.mjs). No son secretos.
# App de Entra de Logística: Información general › Id. de aplicación (cliente) e Id. de directorio (inquilino)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
